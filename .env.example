# Copy this file to .env.local and fill in at least one provider key.
# The app talks to providers through the Vercel AI SDK, so any one of these works.

# --- OpenAI (default primary) -------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini (free, no card at https://aistudio.google.com/apikey) ------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Anthropic ----------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Optional tuning ----------------------------------------------------------
# Fallback order; the first provider whose key is set is primary, the rest are
# tried in order if it fails.
# LLM_PROVIDERS=openai,google,anthropic
# LLM_TIMEOUT_MS=30000
# LLM_MAX_RETRIES=1
